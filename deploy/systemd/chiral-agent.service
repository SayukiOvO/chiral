[Unit]
Description=Chiral node agent
Documentation=https://github.com/SayukiOvO/chiral
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/chiral/agent.env
ExecStart=/usr/local/bin/chiral-agent
Restart=always
RestartSec=5s

# Root, unlike the panel, for one reason: it supervises Xray-core, which binds
# 443. The alternative is CAP_NET_BIND_SERVICE on the xray binary — but a kernel
# upgrade installs a new binary, and a capability that silently fails to follow
# it is worse than one that is plainly there.
#
# StateDirectory still applies: no mkdir, and the identity survives upgrades.
StateDirectory=chiral-agent
StateDirectoryMode=0700

PrivateTmp=true
ProtectHome=true
ProtectKernelModules=true
LockPersonality=true

# Xray holds a descriptor per connection. The default 1024 is a ceiling a busy
# node reaches, and it arrives as unexplained connection refusals rather than
# as anything naming the limit.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
