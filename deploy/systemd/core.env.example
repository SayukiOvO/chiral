# /etc/chiral/core.env — read by chiral-core.service. chmod 600: it holds the
# key that decrypts every private key in the database.
#
# Same variables as the container, because there is only one configuration
# surface. The annotated reference — what each setting costs to get wrong — is
# deploy/panel/.env.example; this file is the minimum a binary install needs.

# --- required ---

# The panel's own address, as agents and subscribers see it. Everything else
# is derived from this: agents dial its host on the gRPC port, subscription
# links are built from it, and its scheme decides whether agents use TLS.
CHIRAL_PUBLIC_URL=https://panel.example.com

# Optional. Only when agents must reach the panel at a different address than
# the one above.
# CHIRAL_GRPC_PUBLIC_ADDR=panel.example.com:26443

# Break-glass admin token. Generate: openssl rand -base64 32
CHIRAL_ADMIN_TOKEN=

# Encrypts REALITY private keys, post-quantum seeds, subscription tokens and
# recorded addresses. Generate: openssl rand -base64 32
#
# BACK THIS UP. Losing it loses every one of those, permanently.
CHIRAL_SECRET_KEY=

# --- TLS ---
#
# Set both and the panel serves HTTPS and gRPC-over-TLS on the two listeners
# itself. Leave both empty and they are plaintext, for a reverse proxy in front
# to terminate. Setting only one is refused rather than half-applied.
#
# Under DynamicUser the dynamic UID cannot read a root-owned key, so hand it
# over through systemd instead of widening the file's permissions:
#
#   /etc/systemd/system/chiral-core.service.d/tls.conf
#     [Service]
#     LoadCredential=tls-cert:/etc/chiral/tls/fullchain.pem
#     LoadCredential=tls-key:/etc/chiral/tls/privkey.pem
#
# and then point these at what systemd exposes:
# CHIRAL_TLS_CERT=%d/tls-cert
# CHIRAL_TLS_KEY=%d/tls-key

# --- paths ---

CHIRAL_DB_PATH=/var/lib/chiral/chiral.db

# The panel keeps one Xray binary per version any node runs, to validate that
# node's config with the kernel that will actually run it. Must survive
# restarts, or the panel forgets every version and falls back to the one it
# shipped with.
CHIRAL_KERNEL_DIR=/var/lib/chiral/kernels

# The panel's own Xray, for `xray -test` and the key generators it cannot
# implement in Go. Install one: see docs/deployment.md.
CHIRAL_XRAY_BIN=/usr/local/bin/xray
XRAY_LOCATION_ASSET=/usr/local/share/xray

# --- listeners ---

# Unusual ports on purpose: 443, 80, 8080 and 8443 are all commonly answered
# by a web server or by Xray on the same host. Both are below 32768 so they
# cannot clash with an outgoing connection's source port either.
#
# The API is on loopback, with nginx or Caddy terminating HTTPS in front of it.
# Serving TLS from the panel itself instead: set the certificate below and bind
# this publicly.
CHIRAL_HTTP_LISTEN=127.0.0.1:26080
CHIRAL_GRPC_LISTEN=:26443

# --- optional ---

# Required as soon as the portal is on, and Core refuses to start without it:
# subscribers would otherwise be handed a relative link no client can use.
# CHIRAL_PUBLIC_URL=https://panel.example.com
# CHIRAL_PORTAL_MODE=open

# The reverse proxy in front of CHIRAL_HTTP_LISTEN, and nothing else. Left
# empty, rate limits key off the peer address; set wrongly, any caller picks
# their own bucket with one header.
# CHIRAL_TRUSTED_PROXY=127.0.0.1
