# /etc/chiral/agent.env — read by chiral-agent.service. chmod 600: JOIN_TOKEN
# is a one-time credential and the state directory holds the long-term one.

# The panel's gRPC endpoint, exactly as the console's "add node" dialog shows
# it. TLS is verified against the system trust store, so this has to match the
# certificate's name — not an IP, unless the certificate names the IP.
PANEL_URL=panel.example.com:26443

# One-time join token from the console. Spent on first registration; the
# long-term credential that replaces it lives in the state directory below.
# Safe to leave here afterwards — it stops working once used.
JOIN_TOKEN=

# Identity, the applied config, and every kernel version this node has been
# upgraded to. Losing it re-registers the node from scratch and drops it back
# to the Xray this machine was installed with.
CHIRAL_STATE_DIR=/var/lib/chiral-agent

# The Xray-core this node starts with. Kernel upgrades install their own under
# CHIRAL_STATE_DIR/kernels and switch to them; this is the floor they fall back
# to, and what runs before the panel has ever been reached.
CHIRAL_XRAY_BIN=/usr/local/bin/xray
XRAY_LOCATION_ASSET=/usr/local/share/xray

# Development only, and never with a panel reachable over the internet: it
# sends the node's credential in the clear.
# CHIRAL_INSECURE=1

# M8 migration observation only. This does NOT hand config, user, traffic or
# lifecycle writes to 3x-ui; direct-xray remains the active owner. The token
# file must be regular and grant no group/other permissions (typically 0400 or 0600).
# CHIRAL_RUNTIME_PROVIDER=3x-ui-shadow
# CHIRAL_3XUI_URL=http://127.0.0.1:2053
# CHIRAL_3XUI_TOKEN_FILE=/etc/chiral/3x-ui.token
# Only for an explicitly remote HTTPS endpoint; loopback is the safe default.
# CHIRAL_3XUI_ALLOW_PUBLIC=1
