[Unit]
Description=Chiral panel
Documentation=https://github.com/SayukiOvO/chiral
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/chiral/core.env
ExecStart=/usr/local/bin/chiral-core
Restart=on-failure
RestartSec=5s

# No account to create and no directory to chown.
#
# DynamicUser allocates a throwaway UID for the lifetime of the service, and
# StateDirectory creates /var/lib/chiral owned by it. The alternative — useradd,
# install -o, and remembering both on every upgrade — is three steps that exist
# only to arrive here.
#
# The database is the one thing that must outlive the process, and it does:
# systemd keeps the directory across restarts and reassigns it to whatever UID
# the next start gets.
DynamicUser=yes
StateDirectory=chiral
StateDirectoryMode=0700

# Serving TLS directly needs one thing this unit deliberately lacks: the
# dynamic UID cannot read a root-owned private key. The installer writes a
# drop-in with LoadCredential for it, or by hand:
#   /etc/systemd/system/chiral-core.service.d/tls.conf
#     [Service]
#     LoadCredential=tls-cert:/etc/chiral/tls/fullchain.pem
#     LoadCredential=tls-key:/etc/chiral/tls/privkey.pem
# with CHIRAL_TLS_CERT=%d/tls-cert and CHIRAL_TLS_KEY=%d/tls-key in core.env.
# A port below 1024 additionally needs AmbientCapabilities=CAP_NET_BIND_SERVICE
# — which is why the defaults are 26080 and 26443: 443, 80, 8080 and 8443 are
# all commonly taken on a host that also runs a web server or Xray.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
# The panel runs `xray -test` and the key generators as subprocesses, so
# execution cannot be blocked wholesale.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
