# Chiral 面板配置示例
#
#   cp .env.example .env && $EDITOR .env && docker compose up -d
#
# compose 用 ${VAR:?...} 强制了必填项，缺了会在启动前就报错，而不是跑起来之后
# 才发现。带 ${VAR:-默认值} 的可以整行删掉。

# ── 必填 ─────────────────────────────────────────────────────────────

# Agent 拨回的地址，会写进「新增节点」生成的 compose 片段里。
# 必须是节点机器解析得到、且连得上的地址。
CHIRAL_GRPC_PUBLIC_ADDR=panel.example.com:8443

# 破窗用的 bearer token，与账号密码并行——密码全丢了也还能进。
#   openssl rand -base64 32
CHIRAL_ADMIN_TOKEN=

# 静态加密密钥。**丢了等于所有密文数据都解不开**：节点私钥、渲染后的 config、
# 用户凭证、告警配置、MFA 密钥、来源地址、订阅 token。
# 换它之前先跑 `chiral-core -rotate-secret-key`，见 docs/deployment.md。
#   openssl rand -base64 32
CHIRAL_SECRET_KEY=

# ── 首个管理员 ───────────────────────────────────────────────────────
#
# 只在库里一个管理员都没有时生效。密码留空则随机生成，并在启动日志里
# **只打印一次**——生产部署建议显式设置，否则得去翻日志。
CHIRAL_ADMIN_USER=admin
CHIRAL_ADMIN_PASSWORD=

# ── 反代 ─────────────────────────────────────────────────────────────
#
# 前面挂了 nginx / Caddy 时**必填**：逗号分隔的地址或 CIDR，只写那一层反代。
# 不设 → 限流按对端地址计，反代后所有人共用一个桶。
# 设错 → 任何调用方一个 X-Forwarded-For 就能自选桶，限流形同虚设。
# CHIRAL_TRUSTED_PROXY=172.18.0.0/16

# 面板自己的对外地址，用来拼订阅链接与认领链接；passkey 也需要它。
# CHIRAL_PUBLIC_URL=https://panel.example.com

# ── 端用户门户 ───────────────────────────────────────────────────────
#
#   off    门户路由整棵树不注册（默认）
#   closed 订阅者可登录，注册关闭；账号靠管理员发认领链接
#   open   开放注册，可用下面的注册码设门槛
#
# 非 off 时**必须**有 CHIRAL_SECRET_KEY，否则 Core 拒绝启动。
CHIRAL_PORTAL_MODE=off
# CHIRAL_PORTAL_INVITE_CODE=

# ── 在线地址记录 ─────────────────────────────────────────────────────
#
# 打开会给每个节点注入 statsUserOnline，也就是一次配置版本变更 + 一次 Xray
# 重启（该节点上的活连接会断一次）。默认关闭。
CHIRAL_ONLINE_RECORD=off

# ── 邮件（可选）──────────────────────────────────────────────────────
#
# 用于管理员的邮箱验证与登录验证码。HOST 留空即不提供邮件因素。
# 服务器不支持 STARTTLS 时会报错，而不是静默降级成明文。
# CHIRAL_SMTP_HOST=
# CHIRAL_SMTP_PORT=587
# CHIRAL_SMTP_USER=
# CHIRAL_SMTP_PASSWORD=
# CHIRAL_SMTP_FROM=chiral@example.com
# CHIRAL_SMTP_TLS=starttls

# ── gRPC 端 TLS（生产必需）───────────────────────────────────────────
#
# 不设则 Agent 连接是明文的。开发期 Agent 需要配合 --insecure。
# CHIRAL_TLS_CERT=/certs/fullchain.pem
# CHIRAL_TLS_KEY=/certs/privkey.pem
