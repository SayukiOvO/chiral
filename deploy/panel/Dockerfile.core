# Web stage: both frontends, built together. Vite emits two entry points —
# the subscriber's portal at / and the operator's console at /admin/ — sharing
# one set of chunks, so this is one build rather than two.
FROM --platform=$BUILDPLATFORM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Build stage.
#
# Pinned to the BUILD platform and cross-compiled, rather than run under
# emulation for each target: Go cross-compiles for free, while a foreign-arch
# toolchain in qemu turns a one-minute build into a fifteen-minute one.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS
ARG TARGETARCH
# Left empty for a plain `docker build`, which is not a release and should not
# claim a version. CI passes the same string it stamps into the tarballs.
ARG VERSION=
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The frontend is compiled INTO the binary (package web), so it has to be in
# the tree before `go build` runs. This overwrites the placeholder that keeps
# `go build ./...` working in a checkout which never built the frontend.
COPY --from=web /web/dist ./web/dist
# modernc.org/sqlite is pure Go, so the binary can be fully static.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath \
      -ldflags="-s -w ${VERSION:+-X main.version=$VERSION}" \
      -o /out/chiral-core ./core/cmd/core

# Xray stage: the PANEL needs its own Xray binary too — it validates every
# rendered config with `xray -test` before storing or pushing it, and derives
# ML-DSA-65 key material that Go's standard library cannot. Same snapshot
# channel as the agent image; pin with --build-arg XRAY_VERSION for
# reproducibility.
# Also on the build platform: this stage only downloads and unpacks a binary
# chosen by TARGETARCH — it never runs it.
FROM --platform=$BUILDPLATFORM alpine:3.20 AS xray
ARG XRAY_VERSION=
ARG TARGETARCH
# GITHUB_TOKEN is optional and mounted as a build secret, never an ARG: an ARG
# is baked into the image history for anyone who pulls it. It only lifts the
# anonymous API rate limit — 60/hour per IP, which CI runners share — so a build
# without it works until that limit is hit.
RUN --mount=type=secret,id=GITHUB_TOKEN \
    apk add --no-cache curl unzip jq \
    && AUTH="" \
    && if [ -s /run/secrets/GITHUB_TOKEN ]; then \
         AUTH="Authorization: Bearer $(cat /run/secrets/GITHUB_TOKEN)"; \
       fi \
    && case "$TARGETARCH" in \
         amd64) XRAY_ARCH=64 ;; \
         arm64) XRAY_ARCH=arm64-v8a ;; \
         *) echo "unsupported arch: $TARGETARCH" && exit 1 ;; \
       esac \
    && VERSION="$XRAY_VERSION" \
    && if [ -z "$VERSION" ]; then \
         VERSION=$(curl -fsSL ${AUTH:+-H "$AUTH"} "https://api.github.com/repos/XTLS/Xray-core/releases?per_page=1" | jq -r '.[0].tag_name'); \
       fi \
    # An unreachable GitHub API leaves VERSION empty, and the pipeline above
    # cannot fail on its own: jq reads the empty stream and exits 0. Without
    # this guard the case-arm below "corrects" the empty string to a bare "v"
    # and the build dies later on a 404 for .../download/v/... — a nonsense URL
    # that says nothing about what actually went wrong. Fail here, with words.
    && { [ -n "$VERSION" ] && [ "$VERSION" != "null" ] \
         || { echo "could not determine the latest Xray version (is api.github.com reachable from the build? pin one with --build-arg XRAY_VERSION=...)" >&2; exit 1; }; } \
    && case "$VERSION" in v*) ;; *) VERSION="v$VERSION" ;; esac \
    && curl -fsSL -o /tmp/xray.zip "https://github.com/XTLS/Xray-core/releases/download/${VERSION}/Xray-linux-${XRAY_ARCH}.zip" \
    && unzip /tmp/xray.zip -d /opt/xray

# Runtime stage
FROM alpine:3.20
RUN adduser -D -H chiral
COPY --from=build /out/chiral-core /usr/local/bin/chiral-core
COPY --from=xray /opt/xray/xray /usr/local/bin/xray
# The geo assets must ship too: routing rules using geosite:/geoip: fail to
# load without them, so `xray -test` would reject configs that are perfectly
# valid on the node.
COPY --from=xray /opt/xray/geoip.dat /opt/xray/geosite.dat /usr/local/share/xray/
# Create and own the data directory BEFORE dropping privileges. A named volume
# inherits the image's ownership of its mountpoint, so without this a fresh
# volume is root-owned and the unprivileged process cannot open the database —
# surfacing as a confusing SQLite error rather than a permissions one.
RUN mkdir -p /var/lib/chiral && chown chiral:chiral /var/lib/chiral
USER chiral
VOLUME /var/lib/chiral
ENV CHIRAL_DB_PATH=/var/lib/chiral/chiral.db \
    CHIRAL_XRAY_BIN=/usr/local/bin/xray \
    CHIRAL_KERNEL_DIR=/var/lib/chiral/kernels \
    XRAY_LOCATION_ASSET=/usr/local/share/xray
EXPOSE 26080 26443
ENTRYPOINT ["chiral-core"]
